# Kopieer dit bestand naar `keystore.properties` en vul je eigen wachtwoord in,
# OF draai `./make-keystore.sh` (die maakt de keystore én dit bestand voor je aan).
# keystore.properties en de .jks staan in .gitignore en komen dus NIET in git.
storeFile=upload-keystore.jks
storePassword=JOUW_WACHTWOORD
keyAlias=upload
keyPassword=JOUW_WACHTWOORD
