root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{kt,kts}]
# @Composable-functies zijn PascalCase → ktlint's function-naming uitzetten.
ktlint_standard_function-naming = disabled
# Lange Compose-/string-regels niet hard afstraffen.
ktlint_standard_max-line-length = disabled
